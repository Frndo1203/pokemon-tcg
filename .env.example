# Copie para .env (não versionado) e preencha.
POSTGRES_USER=tcg
POSTGRES_PASSWORD=tcg
POSTGRES_DB=tcg
# Fora do Docker (CLI, testes). Dentro do compose o host vira "postgres".
POSTGRES_DSN=postgresql://tcg:tcg@localhost:5432/tcg
# Token da API MYP Cards (pedir em https://mypcards.com/acesso-api). Vazio = sem preços MYP.
MYP_API_TOKEN=
